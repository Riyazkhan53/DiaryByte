{
  "expo": {
    "name": "DiaryByte",
    "slug": "diarybyte",
    "description": "A personal diary app for web, iOS, and Android.",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "diarybyte",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.riyazkhan53.diarybyte"
    },
    "android": {
      "package": "com.riyazkhan53.diarybyte",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-font",
      "expo-router",
      "expo-mlkit-ocr",
      "expo-notifications",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow DiaryByte to access your camera so you can scan cards.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f2b94391-1e18-42bc-a449-e3bc9fdd8059"
      }
    },
    "owner": "riyaz-creations",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/f2b94391-1e18-42bc-a449-e3bc9fdd8059"
    }
  }
}
