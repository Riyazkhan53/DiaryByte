{
  "expo": {
    "name": "DiaryByte",
    "slug": "diarybyte",
    "description": "A personal diary app for web, iOS, and Android.",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "diarybyte",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.riyazkhan53.diarybyte"
    },
    "android": {
      "package": "com.riyazkhan53.diarybyte",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-font",
      "expo-router"
    ]
  }
}
